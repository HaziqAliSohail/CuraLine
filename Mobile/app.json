{
  "expo": {
    "name": "CuraLine",
    "slug": "curaline",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.curaline.app"
    },
    "android": {
      "package": "com.curaline.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-notifications",
      "@sentry/react-native"
    ]
  }
}
