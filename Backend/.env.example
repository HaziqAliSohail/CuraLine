# CuraLine environment configuration - copy to .env and fill in real values.
# Generate strong secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Security (REQUIRED) ─────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_VALUE

# ── LLM providers ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Optional Anthropic fallback - leave empty to run OpenAI-only
ANTHROPIC_API_KEY=
# Which provider to try first: "openai" or "anthropic"
LLM_PRIMARY=openai

# ── US insurance eligibility (real-time 270/271) ────────────────────
# Leave blank to run in SANDBOX mode (demoable without a paid account).
# To verify real coverage, set a clearinghouse provider + key
# (e.g. Stedi, pVerify, Availity, Optum).
ELIGIBILITY_PROVIDER=
ELIGIBILITY_API_KEY=
# Stedi adapter (when ELIGIBILITY_PROVIDER=stedi). NPI identifies your practice;
# payer map extends the built-in carrier→payerID defaults (BCBS is state-specific).
ELIGIBILITY_PROVIDER_NPI=
# ELIGIBILITY_PAYER_MAP={"Blue Cross Blue Shield of Texas":"84980"}

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=curaline
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE
POSTGRES_NAME=appointment_management
# Set to True for lightweight local dev without Postgres
USE_SQLITE=False
# Connection pool per web worker. Keep (POOL_SIZE + MAX_OVERFLOW) * workers
# below Postgres max_connections (default 100). e.g. 4 workers * 20 = 80.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Scheduling / triage ─────────────────────────────────────────────
# Travel/lock window (minutes): an appointment starting within this window is
# "locked in" and is never bumped by a severity swap (patient may be en route).
RESCHEDULE_LOCK_MINUTES=120

# ── Process tuning (docker-compose.prod.yml) ────────────────────────
# Gunicorn web workers and per-request hard timeout (seconds).
WEB_CONCURRENCY=3
WEB_TIMEOUT=60
# Celery worker concurrency and recycle-after-N-tasks (bounds memory growth).
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS=200
CELERY_LOGLEVEL=info

# ── API surface ─────────────────────────────────────────────────────
# Publish interactive docs at /docs, /redoc, /openapi.json. Keep False in
# production so the full API surface isn't exposed.
ENABLE_DOCS=False

# ── Telehealth video (Daily.co) ─────────────────────────────────────
# Empty = video visits disabled (sandbox). Set a Daily.co API key to enable.
DAILY_API_KEY=

# ── SMS reminders (Twilio) — all three required to enable ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Payments (Stripe) — empty key = payments disabled ──
STRIPE_SECRET_KEY=
DEFAULT_COPAY_CENTS=2500

# Loguru "diagnose" dumps local variable values into tracebacks (can leak
# PII/PHI). Keep False in production; enable only for local debugging.
LOG_DIAGNOSE=False

# ── PHI encryption at rest ──────────────────────────────────────────
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = PHI stored as plaintext (dev only). REQUIRED for production.
PHI_ENCRYPTION_KEY=
# Strip PHI from finished visits older than N days (0 = keep forever).
PHI_RETENTION_DAYS=0

# ── Observability ───────────────────────────────────────────────────
# Error monitoring. Leave SENTRY_DSN empty to disable Sentry entirely.
SENTRY_DSN=
ENVIRONMENT=production
# Product analytics. Leave POSTHOG_API_KEY empty to log events locally instead.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Email (SMTP) ────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable sending - emails are logged instead,
# so local dev needs no mail server. For production use any SMTP relay
# (SendGrid, Mailgun, AWS SES, Gmail app password, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=CuraLine <no-reply@curaline.com>
# Public URL of the frontend - used to build doctor invite links in emails
FRONTEND_BASE_URL=http://localhost:3001

# ── CORS ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://127.0.0.1

# ── TLS (production) ────────────────────────────────────────────────
# Switch nginx to the TLS config after placing fullchain.pem + privkey.pem
# in Backend/nginx/certs/ (see README "Enabling HTTPS")
# NGINX_CONF=nginx.prod.conf
