# CuraLine environment configuration — copy to .env and fill in real values.
# Generate strong secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Security (REQUIRED) ─────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_VALUE

# ── LLM providers ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Optional Anthropic fallback — leave empty to run OpenAI-only
ANTHROPIC_API_KEY=
# Which provider to try first: "openai" or "anthropic"
LLM_PRIMARY=openai

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=curaline
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE
POSTGRES_NAME=appointment_management
# Set to True for lightweight local dev without Postgres
USE_SQLITE=False

# ── Email (SMTP) ────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable sending — emails are logged instead,
# so local dev needs no mail server. For production use any SMTP relay
# (SendGrid, Mailgun, AWS SES, Gmail app password, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=CuraLine <no-reply@curaline.com>

# ── CORS ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://127.0.0.1

# ── TLS (production) ────────────────────────────────────────────────
# Switch nginx to the TLS config after placing fullchain.pem + privkey.pem
# in Backend/nginx/certs/ (see README "Enabling HTTPS")
# NGINX_CONF=nginx.prod.conf
